# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=""

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=""

# Google OAuth provider (NextAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth session secret
NEXT_AUTH_SECRET=""

# Resend (transactional email)
RESEND_API_KEY=""

# Sender of transactional emails (optional, defaults to "Vig Barber <onboarding@resend.dev>")
EMAIL_FROM=""

# Absolute app URL for links in emails. Falls back to the Vercel production
# domain; in development to the request Host. Production never trusts the
# Host header. Example: https://vigbarber.com
APP_URL=""

# UploadThing (shop logo and banner uploads)
UPLOADTHING_TOKEN=""

# Landing page contact CTA for shop owners (both optional; each button is
# hidden when its variable is unset). WhatsApp takes the number with country
# code, any formatting: +55 11 99999-9999
CONTACT_EMAIL=""
CONTACT_WHATSAPP=""

# Stripe (billing, not live yet). The webhook at /api/stripe/webhook answers
# 503 while either variable is unset. The signing secret comes from the
# webhook endpoint in the Stripe dashboard, or from `stripe listen` locally.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Logins created by `npx prisma db seed` (all optional). SEED_ADMIN_EMAIL is the
# platform admin (defaults to admin@vigbarber.com); SEED_PASSWORD is shared by
# the other demo users. An empty password is generated at random and printed at
# the end of the seed. Passwords need at least 6 characters. Example:
#   SEED_ADMIN_EMAIL="you@example.com"
#   SEED_ADMIN_PASSWORD="choose-a-strong-password"
#   SEED_PASSWORD="demo-password"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_PASSWORD=""

# Stripe price id (price_...) of the "Vig Barber" plan (R$ 99,90/month). Test
# mode and live mode have different ids. Mapped to the plan in app/_lib/plans.ts.
STRIPE_PRICE_BASIC=""
