// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  ATENDENTE
  EMPLOYEE
}

enum Plan {
  TRIAL
  BASIC
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  PIX
  CARD
}

enum Weekday {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime? @map("email_verified")
  image               String?
  phone               String?
  password            String?
  isPlatformAdmin     Boolean   @default(false) @map("is_platform_admin")
  acceptedTermsAt     DateTime? @map("accepted_terms_at")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  bookings    Booking[]
  reviews     Review[]
  employees   Employee[]
  memberships Membership[]
  invitations Invitation[] @relation("InvitationInvitedBy")
}

model Barbershop {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  address              String
  city                 String?
  latitude             Float?
  longitude            Float?
  phones               String[]
  description          String
  logoUrl              String?
  bannerUrl            String?
  instagramUrl         String?
  status               ShopStatus         @default(ACTIVE)
  plan                 Plan               @default(TRIAL)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  services    BarbershopService[]
  employees   Employee[]
  memberships Membership[]
  invitations Invitation[]
  bookings    Booking[]
  expenses    Expense[]
  reviews     Review[]
}

model Membership {
  id           String     @id @default(cuid())
  userId       String
  barbershopId String
  role         MemberRole
  createdAt    DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([userId, barbershopId])
  @@index([barbershopId, role])
}

model Invitation {
  id           String     @id @default(cuid())
  email        String
  barbershopId String
  role         MemberRole
  tokenHash    String     @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  invitedById  String?
  createdAt    DateTime   @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  invitedBy  User?      @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([email])
}

model Employee {
  id           String   @id @default(cuid())
  userId       String
  barbershopId String
  bio          String?
  imageUrl     String?
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  barbershop Barbershop         @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  services   EmployeeService[]
  schedules  EmployeeSchedule[]
  bookings   Booking[]
  reviews    Review[]

  @@unique([userId, barbershopId])
  @@unique([id, barbershopId])
  @@index([barbershopId, isActive])
}

model EmployeeService {
  id         String @id @default(cuid())
  employeeId String
  serviceId  String

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  BarbershopService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
}

model EmployeeSchedule {
  id         String  @id @default(cuid())
  employeeId String
  weekday    Weekday
  startTime  String // e.g. "09:00"
  endTime    String // e.g. "18:00"
  isDayOff   Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, weekday])
}

model BarbershopService {
  id                String            @id @default(cuid())
  barbershopId      String
  name              String
  description       String
  price             Decimal           @db.Decimal(10, 2)
  imageUrl          String
  durationInMinutes Int               @default(30)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  bookings          Booking[]
  employees         EmployeeService[]

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@unique([id, barbershopId])
  @@index([barbershopId])
}

model Booking {
  id                  String         @id @default(cuid())
  barbershopId        String
  userId              String
  barbershopServiceId String
  employeeId          String
  bookingDate         DateTime
  status              BookingStatus  @default(PENDING)
  paymentMethod       PaymentMethod?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  barbershop        Barbershop        @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id])
  // Composite FKs: the service and the employee must belong to the booking's shop
  barbershopService BarbershopService @relation(fields: [barbershopServiceId, barbershopId], references: [id, barbershopId])
  employee          Employee          @relation(fields: [employeeId, barbershopId], references: [id, barbershopId])
  review            Review?

  @@index([barbershopId, bookingDate])
  @@index([employeeId, bookingDate])
}

model Review {
  id           String   @id @default(cuid())
  barbershopId String
  bookingId    String   @unique
  userId       String
  employeeId   String
  rating       Int
  comment      String?
  createdAt    DateTime @default(now())

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)
  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@index([barbershopId])
}

model PasswordResetCode {
  id             String    @id @default(cuid())
  email          String
  code           String
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  failedAttempts Int       @default(0) @map("failed_attempts")
  createdAt      DateTime  @default(now())

  @@index([email])
  @@map("password_reset_codes")
}

enum ExpenseCategory {
  ALUGUEL
  FUNCIONARIOS
  PRODUTOS
  EQUIPAMENTOS
  MARKETING
  CONTAS
  MANUTENCAO
  OUTROS
}

model Expense {
  id           String          @id @default(cuid())
  barbershopId String
  description  String
  amount       Decimal         @db.Decimal(10, 2)
  category     ExpenseCategory
  date         DateTime
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  barbershop Barbershop @relation(fields: [barbershopId], references: [id], onDelete: Cascade)

  @@index([barbershopId, date])
  @@map("expenses")
}
